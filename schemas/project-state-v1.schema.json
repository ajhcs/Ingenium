{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ingenium.local/schemas/project-state-v1.schema.json",
  "title": "Ingenium optional portable continuation v1",
  "description": "Runtime additionally enforces UTF-8 byte limits, ten JSON levels, reference namespaces/cycles, exact unchanged records-v1 rules and delivery project identity. Store validates actual bytes and dependency closure.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "projectId",
    "revision",
    "brief",
    "sources",
    "outputs",
    "nextAction"
  ],
  "properties": {
    "schema": {
      "const": "ingenium-project/1"
    },
    "projectId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$",
      "maxLength": 8192
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "brief": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32768,
      "pattern": "\\S"
    },
    "sources": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/ref"
      }
    },
    "outputs": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/ref"
      }
    },
    "nextAction": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "record": {
      "$ref": "#/$defs/record"
    },
    "openQuestions": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "question",
          "consequence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$",
            "maxLength": 8192
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192,
            "pattern": "\\S"
          },
          "consequence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192,
            "pattern": "\\S"
          }
        }
      }
    },
    "versions": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "revision",
          "sources",
          "previews"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$",
            "maxLength": 8192
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192,
            "pattern": "\\S"
          },
          "revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "sources": {
            "type": "array",
            "maxItems": 256,
            "items": {
              "$ref": "#/$defs/ref"
            }
          },
          "previews": {
            "type": "array",
            "maxItems": 256,
            "items": {
              "$ref": "#/$defs/ref"
            }
          },
          "basedOnVersionId": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$",
            "maxLength": 8192
          }
        }
      }
    },
    "resources": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "providerId",
          "assetId",
          "sourceRevision",
          "originalSHA256",
          "qualificationEvidenceIds",
          "noticeIds",
          "acquisitionMode"
        ],
        "properties": {
          "providerId": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$",
            "maxLength": 8192
          },
          "assetId": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$",
            "maxLength": 8192
          },
          "sourceRevision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192,
            "pattern": "\\S"
          },
          "originalSHA256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "derivedSHA256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "qualificationEvidenceIds": {
            "type": "array",
            "maxItems": 256,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$",
              "maxLength": 8192
            }
          },
          "noticeIds": {
            "type": "array",
            "maxItems": 256,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$",
              "maxLength": 8192
            }
          },
          "acquisitionMode": {
            "enum": [
              "bundled",
              "local",
              "network",
              "injected-fixture"
            ]
          }
        }
      }
    },
    "delivery": {
      "$ref": "delivery-v1.schema.json"
    }
  },
  "$defs": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "sha256",
        "mediaType"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$",
          "maxLength": 8192
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "pattern": "^(?!/)(?!.*[\\\\\\u0000-\\u001f\\u007f:%?#])(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\/\\/?$).+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "mediaType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "pattern": "\\S"
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "id",
        "revision",
        "purpose",
        "evidence",
        "interpretations",
        "decisions",
        "artifacts"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$",
          "maxLength": 8192
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "pattern": "\\S"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "statement"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$",
                "maxLength": 8192
              },
              "statement": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192,
                "pattern": "\\S"
              },
              "source": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192,
                "pattern": "\\S"
              }
            }
          }
        },
        "interpretations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "statement",
              "status",
              "evidenceIds"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$",
                "maxLength": 8192
              },
              "statement": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192,
                "pattern": "\\S"
              },
              "status": {
                "const": "tentative"
              },
              "evidenceIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$",
                  "maxLength": 8192
                }
              }
            }
          }
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "question",
              "scope",
              "status",
              "choice",
              "evidenceIds",
              "interpretationIds"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$",
                "maxLength": 8192
              },
              "question": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192,
                "pattern": "\\S"
              },
              "scope": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192,
                "pattern": "\\S"
              },
              "status": {
                "enum": [
                  "open",
                  "chosen"
                ]
              },
              "choice": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8192,
                    "pattern": "\\S"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "evidenceIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$",
                  "maxLength": 8192
                }
              },
              "interpretationIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$",
                  "maxLength": 8192
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "open"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "properties": {
                    "choice": {
                      "type": "null"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "chosen"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "properties": {
                    "choice": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 8192,
                      "pattern": "\\S"
                    }
                  }
                }
              }
            ]
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "description",
              "evidenceIds",
              "decisionIds"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$",
                "maxLength": 8192
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192,
                "pattern": "\\S"
              },
              "evidenceIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$",
                  "maxLength": 8192
                }
              },
              "decisionIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$",
                  "maxLength": 8192
                }
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192,
                "pattern": "\\S"
              }
            }
          }
        }
      }
    }
  }
}
