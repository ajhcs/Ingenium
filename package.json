{
  "name": "@ajhcs/ingenium",
  "version": "0.2.0-alpha.3",
  "description": "Portable creative guidance for editable engineering graphics, documents and websites, with optional local helpers",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "ingenium": "./bin/ingenium.mjs",
    "ingenium-tools": "./bin/ingenium-tools.mjs"
  },
  "files": [
    "plugin.json",
    "skills/",
    "src/",
    "bin/",
    "examples/",
    "docs/",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "THIRD_PARTY.json",
    "tools/",
    "companion/"
  ],
  "scripts": {
    "test": "node tools/run-tests.mjs",
    "test:installed-renderer": "node --test tests/installed/*.test.mjs",
    "test:python": "python3 tools/run-python-checks.py"
  },
  "optionalDependencies": {
    "sharp": "0.35.4"
  }
}
